# Prefer npm run setup:local --workspace=@foodlify/integration to generate local secrets.
HOST=127.0.0.1
PORT=3010
PG_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
RABBITMQ_USER=foodlify
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://foodlify:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5433/integration
# Set integration when connecting to the private schema in the Foodlify Supabase project.
# Leave empty for the original local Compose database.
DATABASE_SCHEMA=
RABBITMQ_URL=amqp://foodlify:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5673
PAYLOAD_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Tokens must be unique random secrets >=32 characters. Each credential grants exactly one tenant/branch/source.
INTEGRATION_CREDENTIALS='[{"id":"orders-demo","tenantId":"demo","branchId":"main","source":"orders","role":"producer","token":"REPLACE_WITH_RANDOM_PRODUCER_TOKEN"},{"id":"operator-demo","tenantId":"demo","branchId":"main","source":"integration","role":"operator","token":"REPLACE_WITH_RANDOM_OPERATOR_TOKEN"}]'
